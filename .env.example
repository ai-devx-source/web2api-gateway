HOST=0.0.0.0
PORT=3264
SERVICE_NAME=Web2API Gateway
SERVICE_VERSION=1.9.202
SERVICE_BRAND=ai_devx
SERVICE_WATERMARK=ai_devx
SERVICE_DEVELOPER=ai_devx
SERVICE_REPOSITORY=https://github.com/ai-devx-source/web2api-gateway
SERVICE_DISCLAIMER=Use a dedicated test account when possible. Provided as-is, without warranty or liability.

# Use this for service/daemon startup after accounts are authorized.
SKIP_ACCOUNT_MENU=true

# auto = route by request/model; qwen, zai, or deepseek = default route for common endpoint.
API_CONNECTOR_ACTIVE_PROVIDER=auto

# Provider access mode.
# account = use an authorized browser/account session.
# guest = use public guest access where the provider supports it.
# Defaults: Qwen account, Z.ai guest, DeepSeek guest.
API_CONNECTOR_QWEN_AUTH_MODE=account
API_CONNECTOR_ZAI_AUTH_MODE=guest
API_CONNECTOR_DEEPSEEK_AUTH_MODE=guest

# Optional smoke-test overrides.
API_CONNECTOR_BASE_URL=http://127.0.0.1:3264/api
API_CONNECTOR_SMOKE_MODEL=qwen3.7-max

# Z.ai / GLM provider. Guest mode can list guest-available models; account mode requires `npm run zai:auth`.
ZAI_BASE_URL=https://chat.z.ai
ZAI_DEFAULT_MODEL=GLM-5.1
ZAI_FE_VERSION=prod-fe-1.1.44
ZAI_CHAT_TRANSPORT=browser
# Optional: attach to a Chrome instance started with --remote-debugging-port=9222.
# ZAI_BROWSER_URL=http://127.0.0.1:9222

# DeepSeek. Guest mode lists models only; chat completion requires API session token and PoW from browser.
API_CONNECTOR_DEEPSEEK_AUTH_MODE=guest
DEEPSEEK_BASE_URL=https://chat.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Kimi / Moonshot AI. Guest mode lists models only; chat completion requires browser session.
API_CONNECTOR_KIMI_AUTH_MODE=guest
KIMI_BASE_URL=https://kimi.moonshot.cn
KIMI_DEFAULT_MODEL=kimi-k2.6

# MiniMax. Guest mode lists models only; chat completion requires browser session.
API_CONNECTOR_MINIMAX_AUTH_MODE=guest
MINIMAX_BASE_URL=https://agent.minimax.io
MINIMAX_DEFAULT_MODEL=MiniMax-M3
# Optional: attach to a Chrome instance started with --remote-debugging-port=9223.
# DEEPSEEK_BROWSER_URL=http://127.0.0.1:9223
